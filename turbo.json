{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local",
    "biome.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["test","lint", "^build"],
      "cache": true,
      "persistent": false,
      "inputs": ["src/**", "package.json"],
      "outputs": ["dist/**"]
    },
    "test": {},
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
